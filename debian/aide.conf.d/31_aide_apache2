# you can define your own APACHE2_LOGS regex in an earlier file,
# overriding the defaults given here
@@if not defined APACHE2_LOGS
@@if defined APACHE2_SUEXEC
@@define APACHE2_LOGS (access|error|suexec)
@@else
@@define APACHE2_LOGS (access|error)
@@endif
@@endif
 # /var/log/apache2:
 # logrotate, daily, rotate 14, compress, delaycompress, create, missingok
 /var/log/apache2/@@{APACHE2_LOGS}\\.log$ f                   ActLog
 /var/log/apache2/@@{APACHE2_LOGS}\\.log\\.1$ f               RotLog
 /var/log/apache2/@@{APACHE2_LOGS}\\.log\\.2\\.@@{LOGEXT}$ f  CompSerLog
 /var/log/apache2/@@{APACHE2_LOGS}\\.log\\.([3-9]|1[0-3])\\.@@{LOGEXT}$ f MidlSerLog
 /var/log/apache2/@@{APACHE2_LOGS}\\.log\\.14\\.@@{LOGEXT}$ f LastSerLog

 /@@{RUN}/apache2/apache2\\.pid$ f VarFile
 /@@{RUN}/apache2/ssl_scache$ f VarFile
 /var/log/apache2$ d VarDir
 /@@{RUN}/apache2(/socks)?$ d RecreatedDir
