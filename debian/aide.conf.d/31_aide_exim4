@@define EXIM4_VSE var/spool/exim4
@@define EXIM4_VLE var/lib/exim4
@@if not defined EXIM4_SPOOLFILERE
@@define EXIM4_SPOOLFILERE [a-zA-Z0-9]{6}-[a-zA-Z0-9]{11}-[a-zA-Z0-9]{4}
@@endif
 /@@{EXIM4_VSE}/gnutls-params$ f VarFile
 /@@{EXIM4_VSE}/db/(wait-remote_smtp(_smarthost)?|retry|callout)$ f VarFile
!/@@{EXIM4_VSE}/input/@@{EXIM4_SPOOLFILERE}-[DHJ]$ f
!/@@{EXIM4_VSE}/msglog/@@{EXIM4_SPOOLFILERE}$ f
!/@@{EXIM4_VSE}/gnutls-params$ f
!/@@{EXIM4_VSE}/\\.rnd$ f
 /@@{EXIM4_VSE}(/(input|msglog|scan))?$ d VarDir
 /@@{EXIM4_VLE}$ d VarDir
 /@@{EXIM4_VLE}/config\\.autogenerated$ f VarFile
 /@@{RUN}/exim4$ d RecreatedDir
 /@@{RUN}/exim4/exim\\.pid$ f VarFile
 /var/lib/systemd/timers/stamp-exim4-base\\.timer$ f VarFile
@@undef EXIM4_VSE
@@undef EXIM4_VLE
@@undef EXIM4_SPOOLFILERE
 /@@{RUN}/systemd/propagate/exim4\\.service$ d RecreatedDir
